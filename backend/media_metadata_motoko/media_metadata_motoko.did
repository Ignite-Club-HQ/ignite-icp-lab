type Asset = record {
  id : text;
  club_id : text;
  owner : principal;
  kind : text;
  mime : text;
  checksum : text;
  storage_path : text;
  visibility : text;
  content_length : nat64;
  encrypted : bool;
  child_sensitive : bool;
  retention_until_ms : nat64;
  deleted : bool;
  expires_at_ms : nat64;
};
type Capability = record {
  asset_id : text;
  action : text;
  owner : principal;
  allowed : bool;
  purpose : text;
  expires_at_ms : nat64;
};
type Init = record { governor : principal };
type Result = variant { Ok : Asset; Err : text };
type Result_1 = variant { Ok : Capability; Err : text };
type Result_2 = variant { Ok : State; Err : text };
type Result_3 = variant { Ok : Asset; Err : text };
type State = record {
  schema : nat32;
  governor : principal;
  assets : vec Asset;
  capabilities : vec Capability;
};
service : {
  initialize : () -> (variant { Ok; Err : text });
  export_state : () -> (Result_2) query;
  get_asset : (text) -> (opt Asset) query;
  issue_capability : (text, text, text, nat64) -> (Result_1);
  delete_asset : (text) -> (Result_3);
  register_asset : (text, text, text, text, text, text, nat64) -> (Result);
};